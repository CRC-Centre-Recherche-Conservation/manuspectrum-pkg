>
  <skos:ConceptScheme rdf:about="https://manuspectrum.huma-num.fr/6b906328-4abe-4189-a938-f0a374090468">
    <dcterms:title>ManuSpectrum - Element level</dcterms:title>
  </skos:ConceptScheme>
  <skos:Concept rdf:about="https://manuspectrum.huma-num.fr/29909f9c-4db2-4577-b720-313b95fc3906">
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</arches:sortorder>
    <dcterms:identifier>https://manuspectrum.huma-num.fr/plugins/controlled-list-manager/item/29909f9c-4db2-4577-b720-313b95fc3906</dcterms:identifier>
    <skos:inScheme rdf:resource="https://manuspectrum.huma-num.fr/6b906328-4abe-4189-a938-f0a374090468"/>
    <skos:prefLabel xml:lang="en">Major</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Majeur</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Element dominating the signal. Analyst's qualitative estimate from relative signal intensity, not a concentration threshold.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Élément qui domine le signal. Estimation qualitative de l'analyste d'après l'intensité relative du signal, pas un seuil de concentration.</skos:scopeNote>
  </skos:Concept>
  <skos:Concept rdf:about="https://manuspectrum.huma-num.fr/a25f5525-113b-462b-aaa4-9534eccecaee">
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arches:sortorder>
    <dcterms:identifier>https://manuspectrum.huma-num.fr/plugins/controlled-list-manager/item/a25f5525-113b-462b-aaa4-9534eccecaee</dcterms:identifier>
    <skos:inScheme rdf:resource="https://manuspectrum.huma-num.fr/6b906328-4abe-4189-a938-f0a374090468"/>
    <skos:prefLabel xml:lang="en">Trace</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Trace</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Barely detected, close to the signal limit. Analyst's qualitative estimate from relative signal intensity, not a concentration threshold.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Tout juste détecté, près de la limite du signal. Estimation qualitative de l'analyste d'après l'intensité relative du signal, pas un seuil de concentration.</skos:scopeNote>
  </skos:Concept>
  <skos:Concept rdf:about="https://manuspectrum.huma-num.fr/affaf6da-edb4-42cf-8ade-c9d40c55792d">
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arches:sortorder>
    <dcterms:identifier>https://manuspectrum.huma-num.fr/plugins/controlled-list-manager/item/affaf6da-edb4-42cf-8ade-c9d40c55792d</dcterms:identifier>
    <skos:inScheme rdf:resource="https://manuspectrum.huma-num.fr/6b906328-4abe-4189-a938-f0a374090468"/>
    <skos:prefLabel xml:lang="en">Minor</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Mineur</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Clearly present but secondary. Analyst's qualitative estimate from relative signal intensity, not a concentration threshold.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Nettement présent mais secondaire. Estimation qualitative de l'analyste d'après l'intensité relative du signal, pas un seuil de concentration.</skos:scopeNote>
  </skos:Concept>
