    <skos:prefLabel xml:lang="fr">Encrassement</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="https://manuspectrum.huma-num.fr/0451e1bd-4332-45d3-891c-7d40dd8b6f48">
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</arches:sortorder>
