    <skos:prefLabel xml:lang="fr">titres alternatifs</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Titles that vary from the primary title. Distinguished from "alternative titles."</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Titres différant du titre principal. À distinguer des « titres alternatifs ».</skos:scopeNote>
