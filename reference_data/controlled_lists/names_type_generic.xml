    <skos:inScheme rdf:resource="https://manuspectrum.huma-num.fr/6c02daa3-c79c-41cf-bd46-c947a61104b9"/>
    <skos:prefLabel xml:lang="en">translated titles</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">titres traduits</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Titles or names that have been translated into a language other than the original language, or expressed in a writing system other than the original.</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Titres ou noms traduits dans une langue autre que la langue d'origine, ou transcrits dans un autre système d'écriture.</skos:scopeNote>
  </skos:Concept>
