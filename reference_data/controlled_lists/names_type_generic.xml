  <skos:Concept rdf:about="https://manuspectrum.huma-num.fr/5f400d39-3b6b-4b8a-939b-4e49787c7444">
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arches:sortorder>
    <dcterms:identifier>http://vocab.getty.edu/aat/300404670</dcterms:identifier>
    <skos:inScheme rdf:resource="https://manuspectrum.huma-num.fr/6c02daa3-c79c-41cf-bd46-c947a61104b9"/>
    <skos:prefLabel xml:lang="en">preferred terms</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">termes préférentiels</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Terms or names that are designated among all synonyms or lexical variants for a concept, to be used as the default term or name in displays and other situations; distinguished from "nonpreferred terms."</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">Termes ou noms désignés, parmi l'ensemble des synonymes ou variantes lexicales d'un concept, pour servir de forme par défaut dans les affichages et dans d'autres contextes ; à distinguer des « termes non retenus ».</skos:scopeNote>
  </skos:Concept>
  <skos:Concept rdf:about="https://manuspectrum.huma-num.fr/77b29a43-4c3e-4f4e-be44-a5ec7a60e05f">
